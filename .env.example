# Copy to .env (never commit .env). Values here are examples only.
LOZHKA_ENV=local

# One database role per process (least privilege, see docs 02_database_design.md section 1)
LOZHKA_DATABASE_URL_OWNER=postgresql://lozhka_owner:change-me@localhost:5432/lozhka
LOZHKA_DATABASE_URL_API=postgresql://lozhka_api:change-me@localhost:5432/lozhka
LOZHKA_DATABASE_URL_BACKOFFICE=postgresql://lozhka_backoffice:change-me@localhost:5432/lozhka
LOZHKA_DATABASE_URL_PIPELINE=postgresql://lozhka_pipeline:change-me@localhost:5432/lozhka
LOZHKA_DATABASE_URL_PLANNER=postgresql://lozhka_planner:change-me@localhost:5432/lozhka
LOZHKA_DATABASE_URL_REPORT=postgresql://lozhka_report:change-me@localhost:5432/lozhka

# Object storage (product photos, original supplier files)
LOZHKA_OBJECT_STORAGE_ENDPOINT=
LOZHKA_OBJECT_STORAGE_BUCKET=lozhka-local

# Django
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost
# The staff console is a separate process: own secret key, own session cookie, own host name (docs 06 section 7.1)
BACKOFFICE_SECRET_KEY=change-me-too
# Local development: browse http://office.localhost:8011 (Chrome/Edge/Firefox resolve *.localhost; docs 06 section 7.1)
BACKOFFICE_ALLOWED_HOSTS=office.lozhka.example,office.localhost
BACKOFFICE_SESSION_COOKIE_NAME=lozhka_staff_sid
BACKOFFICE_PORT=8011

# Payment provider (test key while developing)
PAYMENT_API_KEY=

# Email and Telegram (module M5 and order emails)
SMTP_URL=
TELEGRAM_BOT_TOKEN=

# Routing
LOZHKA_DATABASE_URL_PURCHASING=postgresql://lozhka_purchasing:change-me@localhost:5432/lozhka
# Comma-separated Fernet keys, newest first (rotation). Set ONLY in the purchasing worker's environment.
SUPPLIER_SECRET_KEYS=

OSRM_URL=http://127.0.0.1:5000
PDOK_URL=https://api.pdok.nl/bzk/locatieserver/search/v3_1

# Errors
SENTRY_DSN=

# Stage 1 additions
# Folder with the seed CSVs (default: db/seeds)
LOZHKA_SEEDS_DIR=db/seeds
# Public RSA key (PEM text) used to seal supplier credentials; local dev auto-creates a pair under .secrets/
SUPPLIER_SECRET_PUBLIC_KEY=
# Customer site -> API address used by Next.js rewrites
API_URL=http://localhost:8010
